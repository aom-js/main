{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2019",
    // "sourceMap": true,
    // "baseUrl": "packages",
    "incremental": false,
    "esModuleInterop": true,
    "inlineSourceMap": true
  },
  "paths": { "*": ["./packages/*"] },
  "include": ["packages"],
  "exclude": ["build", "node_modules", "sample", "**/*.spec.ts", "test/**"]
}
