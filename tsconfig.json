{
  // Проверка типов исходников всех пакетов одной командой: bunx tsc -p tsconfig.json --noEmit
  // (verify.sh, после сборки — импорты между пакетами читают dist/types). Сборка идёт
  // пакетными tsconfig.build*.json; настройки — общая база (node10 в TS 7 удалён, aom-main-x00).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // bun не поднимает @types/node в корень — берём из пакета
    "typeRoots": ["./packages/core/node_modules/@types"]
  },
  "include": ["packages/*/src"]
}
