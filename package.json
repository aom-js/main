{
  "name": "@aom-js/main",
  "version": "0.1.1",
  "description": "`@aom` meta-framework monorepo",
  "homepage": "https://aom.js.org/",
  "bugs": {
    "url": "https://github.com/aom-js/main/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aom-js/main.git"
  },
  "license": "ISC",
  "author": "Grigory B. Kholstinnikov (scarych)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "bun --filter @aom-js/core build",
    "build:schemer": "bun --filter @aom-js/schemer build",
    "build:router": "bun --filter @aom-js/router build",
    "build:transfer": "bun --filter @aom-js/transfer build",
    "build:codegen": "bun --filter @aom-js/codegen build",
    "build:holder": "bun --filter @aom-js/holder build",
    "build:visualizer": "bun --filter @aom-js/visualizer build",
    "build:api": "bun --filter @aom-js/api build",
    "build": "bun build:core && bun build:schemer && bun build:router && bun build:transfer && bun build:codegen && bun build:holder && bun build:visualizer && bun build:api && bun smoke",
    "smoke": "node scripts/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
    "clean": "bun --filter '@aom-js/*' clean && node scripts/clean.js",
    "prebuild": "node scripts/prebuild.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.46",
    "@vitest/coverage-v8": "^4.1.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}