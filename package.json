{
  "name": "@aom/main",
  "version": "0.0.1",
  "description": "`@aom` meta-framework monorepo",
  "homepage": "https://github.com/aom-js/main#readme",
  "bugs": {
    "url": "https://github.com/aom-js/main/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aom-js/main.git"
  },
  "license": "ISC",
  "author": "Grigory B. Kholstinnikov (scarych)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "yarn workspace @aom/core build",
    "build:schemer": "yarn workspace @aom/schemer build",
    "build:api": "yarn workspace @aom/api build",
    "build:transfer": "yarn workspace @aom/transfer build",
    "build": "yarn build:core && yarn build:schemer && yarn build:api && yarn build:transfer",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "publish": "yarn build && yarn workspaces run publish",
    "clean": "yarn workspaces run clean && node scripts/clean.js",
    "prebuild": "node scripts/prebuild.js && yarn workspaces run prebuild"
  }
}
