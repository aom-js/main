{
  "name": "@aom-js/main",
  "version": "0.0.1",
  "description": "`@aom` meta-framework monorepo",
  "homepage": "https://github.com/aom-js/main#readme",
  "bugs": {
    "url": "https://github.com/aom-js/main/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aom-js/main.git"
  },
  "license": "ISC",
  "author": "Grigory B. Kholstinnikov (scarych)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "yarn workspace @aom-js/core build",
    "build:schemer": "yarn workspace @aom-js/schemer build",
    "build:router": "yarn workspace @aom-js/router build",
    "build:transfer": "yarn workspace @aom-js/transfer build",
    "build": "yarn build:core && yarn build:schemer && yarn build:router && yarn build:transfer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "yarn workspaces run lint",
    "publish": "yarn build && yarn workspaces run publish",
    "clean": "yarn workspaces run clean && node scripts/clean.js",
    "prebuild": "node scripts/prebuild.js && yarn workspaces run prebuild"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@vitest/coverage-v8": "^4.1.10",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
