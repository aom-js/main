{
  "name": "@aom-js/main",
  "version": "0.0.1",
  "description": "`@aom` meta-framework monorepo",
  "homepage": "https://github.com/aom-js/main#readme",
  "bugs": {
    "url": "https://github.com/aom-js/main/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aom-js/main.git"
  },
  "license": "ISC",
  "author": "Grigory B. Kholstinnikov (scarych)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "bun --filter @aom-js/core build",
    "build:schemer": "bun --filter @aom-js/schemer build",
    "build:router": "bun --filter @aom-js/router build",
    "build:transfer": "bun --filter @aom-js/transfer build",
    "build:holder": "bun --filter @aom-js/holder build",
    "build:api": "bun --filter @aom-js/api build",
    "build": "bun build:core && bun build:schemer && bun build:router && bun build:transfer && bun build:holder && bun build:api && bun smoke",
    "smoke": "node scripts/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "bun --filter @aom-js/* run lint",
    "publish": "bun build && bun --filter @aom-js/* publish",
    "clean": "bun --filter '@aom-js/*' clean && node scripts/clean.js",
    "prebuild": "node scripts/prebuild.js"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@vitest/coverage-v8": "^4.1.10",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.2"
  }
}
