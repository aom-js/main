{
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "./dist/cjs",
    "./dist/mjs",
    "./dist/types"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/mjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist/",
    "prebuild": "rm -rf dist/",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.mjs.json  && tsc --project tsconfig.build.types.json && node ../../scripts/post-build.js",
    "prepare": ""
  }
}