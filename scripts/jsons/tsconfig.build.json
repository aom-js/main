{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/cjs",
    // Единственная комбинация, дающая CommonJS под TS7: node10 удалён, а node16/nodenext
    // требуют module=node16. Пара commonjs + bundler (bundler наследуется из базы)
    // невалидна для TS5, но этот файл читает только воркспейсный tsc, не IDE.
    "module": "commonjs",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.mjs"]
}
