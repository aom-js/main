{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/cjs",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // "paths": { "*": ["../packages/*"] },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.mjs"]
}
